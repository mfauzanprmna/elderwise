# Folder unggahan: hanya untuk file statis (PDF & gambar). Skrip tidak boleh dijalankan dari sini,
# sebagai lapisan pengaman tambahan bila ada file berbahaya yang lolos.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
