APP_NAME=ElderWiSE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# --- Email (dipakai fitur "Lupa kata sandi") ---
# 'log' = email TIDAK dikirim, melainkan ditulis ke storage/logs/laravel.log (untuk uji lokal).
# Untuk mengirim email sungguhan, ganti ke smtp dan isi data server email Anda:
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=alamat@gmail.com
# MAIL_PASSWORD="sandi-aplikasi-16-karakter"
# MAIL_SCHEME=            # isi "smtps" jika memakai port 465
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="ElderWiSE"

# --- Login dengan Google ---
# Buat OAuth Client ID (tipe "Web application") di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI harus SAMA PERSIS dengan GOOGLE_REDIRECT_URI di bawah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Folder file upload (PDF materi, logo, lencana, latar sertifikat) ---
# Bawaan: public/uploads (tanpa symlink, tidak perlu `php artisan storage:link`). Biarkan baris di bawah tetap
# dikomentari kecuali folder web hosting Anda terpisah dari folder aplikasi (mis. public_html):
# UPLOADS_PATH=/home/NAMAUSER/public_html/uploads
# UPLOADS_URL=/uploads
